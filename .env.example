# ═══════════════════════════════════════════════════════════════════
# Viral-X AI Sales Agent — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
PORT=3000

# ── Database ────────────────────────────────────────────────────────
# Leave blank to use the default: viral_x.db in project root
DATABASE_PATH=

# ══ LLM Provider (choose ONE — priority: Gemini > Anthropic > OpenAI) ══

# Option 1: Google Gemini (Recommended)
# Models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 2: Anthropic Claude
# Models: claude-sonnet-4-5, claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Option 3: OpenAI GPT
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ══ External Commerce Integrations (optional — leave blank for demo mode) ══

# Shopify
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# WooCommerce
WOOCOMMERCE_URL=https://your-shop.com
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# Restaurant Table Management (SevenRooms / Resy)
RESTAURANT_API_KEY=

# Clinical EHR (HL7 / FHIR)
CLINIC_EHR_ENDPOINT=
CLINIC_EHR_TOKEN=

# ══ WhatsApp Business Cloud API (optional — falls back to wa.me link) ══
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
