# =====================================================================
# Viral-X Python Backend Configuration Template
# Sprint 2.5 Migration Foundation
# =====================================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database Connection (Defaults to the existing root SQLite database)
# For SQLite: sqlite:///../viral_x.db (relative to backend/ directory)
# For Future PostgreSQL / Supabase: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///../viral_x.db

# Security & Limits
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_SIZE_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30.0

# Future AI Provider Keys (Server-side only — never expose to frontend)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
